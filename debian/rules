#!/usr/bin/make -f

export PYBUILD_NAME = stiky-notes

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Install desktop entry
	install -D -m 644 debian/stiky-notes.desktop \
		debian/stiky-notes/usr/share/applications/stiky-notes.desktop
	# Install autostart entry
	install -D -m 644 debian/stiky-notes.autostart \
		debian/stiky-notes/etc/xdg/autostart/stiky-notes.desktop
	# Install icons
	for size in 16 22 24 32 48 64 128 256; do \
		install -D -m 644 debian/icons/stiky-notes-$${size}.png \
			debian/stiky-notes/usr/share/icons/hicolor/$${size}x$${size}/apps/stiky-notes.png; \
	done
	install -D -m 644 src/kde_plasma_stiky_notes/icons/stiky-notes.svg \
		debian/stiky-notes/usr/share/icons/hicolor/scalable/apps/stiky-notes.svg
	# Install D-Bus activation file (nome registrato dall'istanza singola)
	install -D -m 644 debian/org.kde.StikyNotes.service \
		debian/stiky-notes/usr/share/dbus-1/services/org.kde.StikyNotes.service


override_dh_auto_test:
	QT_QPA_PLATFORM=offscreen python3 -m pytest tests/ -v

override_dh_auto_clean:
	dh_auto_clean
	rm -rf build dist *.egg-info .pytest_cache .mypy_cache .ruff_cache
